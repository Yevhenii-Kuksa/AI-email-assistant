    {
      "parameters": {
        "jsCode": "const response = $input.first().json.output[0].content[0].text;\nconst parsed = JSON.parse(response);\n\nconst email = $(\"Edit Fields\").first().json;\n\nconst labelMap = {\n  \"AI/Orders\": \"Label_1835044198996308257\",\n  \"AI/Work\": \"Label_2493597732039766903\",\n  \"AI/Billing\": \"Label_3162581820128751293\",\n  \"AI/Personal\": \"Label_5058720270223141726\",\n  \"AI/Support\": \"Label_5381739352959915487\",\n  \"AI/Sales\": \"Label_6601621660173406268\",\n  \"AI/Marketing\": \"Label_7773279605519753797\",\n  \"AI/Other\": \"Label_7848458115835989925\",\n  \"AI/Spam\": \"Label_8316195166832284121\",\n  \"AI/Notifications\": \"Label_8937417686375835306\",\n  \"AI/Newsletter\": \"Label_918897183596034797\"\n};\n\nconst labelId = labelMap[parsed.category] || labelMap[\"AI/Other\"];\n\nreturn [\n  {\n    json: {\n      date: new Date().toISOString(),\n      id: email.id || \"\",\n      from: email.From || email.from || \"\",\n      subject: email.Subject || email.subject || \"\",\n      text: email.Text || email.text || email.snippet || \"\",\n      category: parsed.category,\n      labelId,\n      priority: parsed.priority,\n      summary: parsed.summary,\n      requires_action: parsed.requires_action\n    }\n  }\n];"
      },
