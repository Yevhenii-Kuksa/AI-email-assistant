        "responses": {
          "values": [
            {
              "content": "=You are an AI Email Assistant for business.\n\nAnalyze the email and return ONLY valid JSON.\n\nEmail:\n\nFrom: {{$json[\"From\"]}}\n\nSubject: {{$json[\"Subject\"]}}\n\nSnippet: {{$json[\"snippet\"]}}\n\nTasks:\n\n1. Detect the language of the email automatically.\n\n2. Classify the email into ONE category:\n- AI/Support\n- AI/Billing\n- AI/Sales\n- AI/Orders\n- AI/Work\n- AI/Personal\n- AI/Marketing\n- AI/Newsletter\n- AI/Notifications\n- AI/Spam\n- AI/Other\n\n3. Set priority:\n- High = urgent, payment, customer issue, legal matter, important business request\n- Medium = requires attention but is not urgent\n- Low = informational, newsletter or personal\n\n4. Write a summary:\n- Maximum 20 words.\n- Focus only on the key point.\n- Do NOT repeat the whole email.\n- Write the summary in the SAME LANGUAGE as the email.\n\n5. requires_action:\nReturn true only if a human should reply or perform an action.\nOtherwise return false.\n\nReturn ONLY this JSON:\n\n{\n  \"category\": \"\",\n  \"priority\": \"\",\n  \"summary\": \"\",\n  \"requires_action\": true\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
